# Firebase Configuration (Production or Local Emulator)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=roadsense-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roadsense-ai
VITE_FIREBASE_STORAGE_BUCKET=roadsense-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_DATABASE_URL=https://roadsense-ai-default-rtdb.firebaseio.com

# Emulator flags (Set true to test offline without Firebase project)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_HOST=localhost

# Map Settings
VITE_DEFAULT_MAP_LAT=12.9716
VITE_DEFAULT_MAP_LON=77.5946
VITE_DEFAULT_MAP_ZOOM=14

# Model Settings
VITE_DEFAULT_CONFIDENCE_THRESHOLD=0.65
VITE_DEFAULT_REACTION_TIME_SEC=1.5
